+// --- Liveness heartbeat (SNP_HEARTBEAT=1) -----------------------------------
+//
+// Counts display lists the GAME submits. This is the only trustworthy "is the
+// game still running?" signal we have: it is produced by game logic itself and
+// is completely independent of any screen capture.
+//
+// Why it exists: on 2026-08-15 a screenshot-diffing harness repeatedly reported
+// a build as "animating" while the user watched it sit frozen. Captures were
+// taken from a *minimized* window, where xwd does not reliably reflect what is
+// being drawn, so "consecutive frames differ" was capture noise. Do not use
+// frame differences to judge liveness -- use this.
+//
+// A sampling thread does the reporting rather than the submit path, because the
+// interesting event is submissions STOPPING, which by definition can't print
+// from inside the submit function.
+// Base of the emulated RDRAM, for scripts/gdb_watch.sh. See init_events.
+uint8_t* g_rdram_base = nullptr;
+
+void recomp_walk_report(long long secs);
+void recomp_phase_report(long long secs);
+
+std::atomic<uint64_t> g_gfx_task_count{ 0 };
+// Non-graphics RSP tasks (audio, in this game). Discriminates "the game's frame
+// loop stopped entirely" from "only the graphics branch stopped being taken".
+std::atomic<uint64_t> g_other_task_count{ 0 };
+
+// VI delivery probe counters, defined in mesgqueue.cpp. Reported from here so
+// the timeline keeps advancing once the game itself goes quiet.
+extern std::atomic<uint64_t> g_viprobe_vi_enq;
+extern std::atomic<uint32_t> g_viprobe_vi_mq;
+extern std::atomic<uint64_t> g_viprobe_send_ok;
+extern std::atomic<uint64_t> g_viprobe_send_full;
+extern std::atomic<uint64_t> g_viprobe_send_woke;
+extern std::atomic<uint64_t> g_viprobe_recv_ok;
+extern std::atomic<uint64_t> g_viprobe_recv_block;
+extern std::atomic<int32_t>  g_viprobe_last_blocker;
+uint32_t viprobe_target_mq();
+
+static void heartbeat_thread_func() {
+    ultramodern::set_native_thread_name("Heartbeat");
+    const auto start = std::chrono::steady_clock::now();
+    uint64_t last = 0;
+    uint64_t stalled_secs = 0;
+    uint64_t p_enq = 0, p_ok = 0, p_full = 0, p_woke = 0, p_rok = 0, p_rblk = 0;
+    uint64_t last_other = 0;
+    while (true) {
+        std::this_thread::sleep_for(std::chrono::seconds(1));
+        uint64_t now_other = g_other_task_count.load();
+        uint64_t other_delta = now_other - last_other;
+        last_other = now_other;
+        uint64_t now_count = g_gfx_task_count.load();
+        uint64_t delta = now_count - last;
+        last = now_count;
+        auto secs = std::chrono::duration_cast<std::chrono::seconds>(
+            std::chrono::steady_clock::now() - start).count();
+        if (delta == 0) {
+            stalled_secs++;
+            fprintf(stderr, "[heartbeat] t=%llds gfx_tasks=%llu  +0  other=%llu +%llu  <<< NO GFX TASKS (%llus stalled)\n",
+                (long long)secs, (unsigned long long)now_count,
+                (unsigned long long)now_other, (unsigned long long)other_delta,
+                (unsigned long long)stalled_secs);
+        }
+        else {
+            stalled_secs = 0;
+            fprintf(stderr, "[heartbeat] t=%llds gfx_tasks=%llu  +%llu  other=%llu +%llu\n",
+                (long long)secs, (unsigned long long)now_count, (unsigned long long)delta,
+                (unsigned long long)now_other, (unsigned long long)other_delta);
+        }
+
+        // --- Memory watch (SNP_WATCH=0xADDR[,0xADDR...]) --------------------
+        //
+        // DIAGNOSTIC (2026-08-17). Sample game bytes once per second from this
+        // native thread. Written to test the gate at 0x80068A95: boot_func_
+        // 800261FC returns immediately when that byte is nonzero, skipping the
+        // call chain that feeds the queue thread 17 is stuck on. Reading from
+        // here needs no toml hook and so no recompile -- a byte watch that
+        // costs a rebuild is a byte watch you don't run.
+        // Byte addressing is XOR-3 swapped (see MEM_BU in recomp.h).
+        //
+        // A token of the form BASE+LEN watches a whole word range and reports
+        // only the words that CHANGED. Added to recover the destination pointer
+        // of the write that corrupts the callback table: the writer is a 4x4
+        // matrix multiply storing 16 consecutive words, so the extent of the
+        // damage gives the base it wrote from, which a single-address watch
+        // cannot show.
+        if (const char* watch = getenv("SNP_WATCH")) {
+            struct Region { uint32_t base; uint32_t words; };
+            static std::vector<Region> regions = [&]() {
+                std::vector<Region> out;
+                for (const char* p = watch; *p; ) {
+                    uint32_t base = (uint32_t)strtoul(p, nullptr, 0);
+                    uint32_t words = 1;
+                    const char* comma = strchr(p, ',');
+                    const char* plus = strchr(p, '+');
+                    if (plus != nullptr && (comma == nullptr || plus < comma)) {
+                        words = (uint32_t)strtoul(plus + 1, nullptr, 0) / 4;
+                        if (words == 0) words = 1;
+                    }
+                    out.push_back({ base & ~3u, words });
+                    if (comma == nullptr) break;
+                    p = comma + 1;
+                }
+                return out;
+            }();
+
+            static std::vector<uint32_t> addrs = [&]() {
+                std::vector<uint32_t> out;
+                for (const Region& r : regions) {
+                    for (uint32_t i = 0; i < r.words; i++) {
+                        out.push_back(r.base + i * 4);
+                    }
+                }
+                return out;
+            }();
+            const bool range_mode = addrs.size() > regions.size();
+            static std::vector<uint32_t> last(addrs.size(), 0);
+            static bool primed = false;
+            uint8_t* rdram = events_context.rdram;
+            if (rdram != nullptr) {
+                for (size_t i = 0; i < addrs.size(); i++) {
+                    // Words are stored natively (only BYTE access is XOR-3).
+                    uint32_t word = *(uint32_t*)(rdram + (addrs[i] - 0x80000000u));
+                    bool changed = primed && word != last[i];
+                    // In range mode only changes are interesting -- printing a
+                    // whole region every second would bury them.
+                    if (!range_mode || changed) {
+                        fprintf(stderr, "[watch] t=%llds 0x%08X word=0x%08X%s\n",
+                            (long long)secs, addrs[i], word,
+                            changed ? "   <<< CHANGED" : "");
+                    }
+                    last[i] = word;
+                }
+                primed = true;
+            }
+        }
+
+        recomp_walk_report((long long)secs);
+        recomp_phase_report((long long)secs);
+
+        if (viprobe_target_mq() != 0) {
+            uint64_t enq = g_viprobe_vi_enq.load(), ok = g_viprobe_send_ok.load();
+            uint64_t full = g_viprobe_send_full.load(), woke = g_viprobe_send_woke.load();
+            uint64_t rok = g_viprobe_recv_ok.load(), rblk = g_viprobe_recv_block.load();
+            fprintf(stderr, "[viprobe] t=%llds target=0x%x vi_enq=%llu(+%llu ->mq=0x%x) "
+                    "send_ok=%llu(+%llu) send_full=%llu(+%llu) woke=%llu(+%llu) "
+                    "recv_ok=%llu(+%llu) recv_block=%llu(+%llu, last thread %d)\n",
+                (long long)secs, viprobe_target_mq(),
+                (unsigned long long)enq,  (unsigned long long)(enq - p_enq),
+                g_viprobe_vi_mq.load(),
+                (unsigned long long)ok,   (unsigned long long)(ok - p_ok),
+                (unsigned long long)full, (unsigned long long)(full - p_full),
+                (unsigned long long)woke, (unsigned long long)(woke - p_woke),
+                (unsigned long long)rok,  (unsigned long long)(rok - p_rok),
+                (unsigned long long)rblk, (unsigned long long)(rblk - p_rblk),
+                g_viprobe_last_blocker.load());
+            p_enq = enq; p_ok = ok; p_full = full; p_woke = woke; p_rok = rok; p_rblk = rblk;
+        }
+    }
+}
+
+// --- Stub-reachability probe (SNP_STUB_PROBE=1) -----------------------------
+//
+// DIAGNOSTIC (2026-08-17). N64Recomp emits an EMPTY BODY for every function it
+// cannot recompile (137 of them here, mostly overlay code), and it does so
+// silently -- twice already a silently-stubbed function turned out to sit on
+// the live per-frame path (see the 2026-08-13 evening entry). The attract
+// sequence stops submitting display lists at exactly gfx task 1240 in every
+// run, which is a deterministic state transition, so the question is whether
+// that transition dispatches into a stub.
+//
+// scripts/probe_stubs.py injects a call to this into every empty stub body.
+// First call per function only, stamped with the gfx task count -- a stub whose
+// first call lands at ~1240 is the suspect. Ones that fired long before are not.
+extern "C" void recomp_stub_hit(const char* name) {
+    static const bool enabled = getenv("SNP_STUB_PROBE") != nullptr;
+    if (!enabled) {
+        return;
+    }
+    static std::mutex seen_mutex;
+    static std::set<std::string> seen;
+    std::lock_guard lock{ seen_mutex };
+    if (seen.insert(name).second) {
+        fprintf(stderr, "[stub] gfx_task=%llu FIRST CALL: %s\n",
+            (unsigned long long)g_gfx_task_count.load(), name);
+    }
+}
+
+extern "C" void recomp_stub_hit(const char* name);
+
+// Shared raw-address backtrace printer for the diagnostic probes. Recompiled
+// output is ordinary C with global symbols, so the frames name game functions;
+// resolve with scripts/resolve_bt.sh. Raw addresses only, because
+// backtrace_symbols() sees only dynamic symbols and this binary is linked
+// without -rdynamic. The anchor line lets the resolver undo PIE's load slide.
+void probe_backtrace(const char* tag) {
+    static std::once_flag anchor_once;
+    std::call_once(anchor_once, []() {
+        fprintf(stderr, "[taskbt] anchor recomp_stub_hit=%p\n", (void*)&recomp_stub_hit);
+    });
+    void* frames[24];
+    int count = backtrace(frames, 24);
+    fprintf(stderr, "[taskbt] %s depth=%d:", tag, count);
+    for (int i = 0; i < count; i++) {
+        fprintf(stderr, " %p", frames[i]);
+    }
+    fprintf(stderr, "\n");
+}
+
+struct WalkStat {
+    uint32_t min_sp = 0xFFFFFFFFu;
+    uint32_t max_sp = 0;
+    std::set<uint32_t> types;    // distinct node types dispatched on
+    uint64_t calls = 0;
+    // Shadow stack of the descent in progress: (caller sp, node).
+    std::vector<std::pair<uint32_t, uint32_t>> path;
+    uint32_t max_path = 0;       // deepest recursion level reached
+    uint32_t deepest_node = 0;   // the node sitting at that depth
+    // A18 (2026-08-18): root of each top-level descent. See the probe body.
+    uint32_t last_frame = 0xFFFFFFFFu; // SNP_WALK_FRAMED: frame of the live descent
+    // A80 (2026-08-18): per-FRAME sp extremes, reset with the frame. min_sp/max_sp
+    // above are cumulative over the whole run, which is why `depth` was never a
+    // per-frame depth (A78). These two are.
+    uint32_t f_max_sp = 0;
+    uint32_t f_min_sp = 0xFFFFFFFFu;
+    uint32_t p_max_sp = 0;       // previous frame's values, held for reporting
+    uint32_t p_min_sp = 0;
+    uint32_t root = 0;           // most recent top-level node
+    uint64_t roots = 0;          // top-level descents seen
+    uint32_t root_changes = 0;   // times that root differed from the previous
+    uint64_t cycles = 0;         // descents that revisited a node
+    uint32_t cycle_node = 0;     // first node caught repeating
+    uint32_t cycle_depth = 0;    // level it repeated at
+    uint32_t cycle_parent = 0;   // node whose child list holds the bad edge
+    uint32_t cycle_list = 0;     // that child list's address (watchpoint target)
+    uint8_t  cycle_list_bytes[8] = {};
+    uint64_t cycle_gfx = 0;      // gfx task count when it first appeared
+    std::vector<uint32_t> cycle_path;
+};
+static std::mutex walk_mutex;
+static std::map<int32_t, WalkStat> walk_stats;
+
+// --- Scene-walk depth probe (SNP_WALK=1) ------------------------------------
+//
+// DIAGNOSTIC (2026-08-17). boot_func_80033758 walks a scene graph by reading a
+// list of child indices from (node + 8) that is terminated ONLY by a 0xFF byte,
+// recursing once per entry. If that pointer or its contents are wrong the walk
+// runs over arbitrary bytes and recurses arbitrarily deep -- which is what
+// drives thread 4's stack off its floor and onto the callback table at frame
+// 1240 (see docs/boot-debugging-2026-08-13.md, 2026-08-17 final).
+//
+// Called from a toml hook at the function's entry, so ctx->r29 is still the
+// CALLER's stack pointer; its minimum over time is the stack low-water mark.
+// Counters plus one line per second -- deliberately cheap, because a probe on a
+// hot path that changes timing measures itself (see the playbook).
+extern "C" void recomp_walk_probe(uint8_t* rdram, uint32_t sp, uint32_t node) {
+    static const bool enabled = getenv("SNP_WALK") != nullptr;
+    if (!enabled) {
+        return;
+    }
+    // PER THREAD. The first version kept one global min_sp, which is useless
+    // here: thread 3's stack lives at 0x80067xxx and thread 4's at 0x8007xxxx,
+    // so a global minimum is always thread 3's and thread 4 -- the one that
+    // overflows -- never shows up at all. Track each thread separately, and
+    // report depth relative to that thread's own highest observed sp.
+    int32_t tid = ultramodern::is_game_thread()
+        ? TO_PTR(OSThread, ultramodern::this_thread())->id
+        : -1;
+
+    auto valid = [](uint32_t a) { return a >= 0x80000000u && a < 0x80800000u; };
+
+    // The node's TYPE, at offset 0 as a halfword. boot_func_80033758 dispatches
+    // on it: `lhu $v0, 0($s3); sll $v1, $v0, 2; lw $v0, -0x68B8($v0=0x80060000)`
+    // -> a vtable at 0x80059748 indexed by type*4. A type of 0xFFFF indexes
+    // 0x80059748 + 0x3FFC0 = 0x80099744, far outside it.
+    //
+    // NOTE, 2026-08-18: this replaced a `list_len`/`bad` pair that walked a
+    // 0xFF-terminated BYTE list at node+8. **That structure does not exist.**
+    // The generated source shows the children are a counted array reached
+    // through the THIRD argument: (a2)+0 -> object, +0 = entry array, +4 =
+    // count, entries 0x10 bytes. The old probe was reading unrelated memory,
+    // and its reassuring `longest_list=4 bad=0` is what the 2026-08-17 handoff
+    // used to rule out "malformed child lists". That rule-out is VOID.
+    uint32_t type = 0xFFFFFFFFu;
+    if (valid(node)) {
+        uint32_t w = *(uint32_t*)(rdram + (node - 0x80000000u));
+        type = w >> 16;
+    }
+
+    std::lock_guard lock{ walk_mutex };
+    WalkStat& s = walk_stats[tid];
+    s.calls++;
+    if (sp < s.min_sp) s.min_sp = sp;
+    if (sp > s.max_sp) s.max_sp = sp;
+    if (type != 0xFFFFFFFFu) s.types.insert(type);
+
+    // CYCLE vs GROWTH (2026-08-18). Depth climbs by exactly 720 bytes/second
+    // (9 frames of 0x50) from t=40s onward, forever. Two shapes produce that:
+    //
+    //   cycle  -- the graph gained an edge back into itself, so one descent
+    //             revisits the same node over and over
+    //   growth -- something appends a fresh node per frame and never removes
+    //             it, so each descent is legitimately one level deeper
+    //
+    // They call for completely different fixes, and the counters above cannot
+    // tell them apart. This maintains a shadow stack of the current descent:
+    // the walker recurses, so sp falls on the way down and rises on return.
+    // Entries whose recorded sp is above the current one have returned and are
+    // popped. If the incoming node is still somewhere in what remains, this
+    // descent has revisited it -- a cycle.
+    // <=, not <. The probe records the CALLER's sp, so every sibling at a given
+    // level records the identical value; a strict < leaves the previous sibling
+    // on the path forever, inflating the depth and reporting phantom cycles.
+    // Caught by the free positive control this run already contains: t=7-39s is
+    // a known-healthy walk pinned at 640 bytes (8 levels), and the first version
+    // claimed 37 levels and 23 cycles there. A parent is never popped by its own
+    // child's arrival, because the child's recorded sp is strictly smaller.
+    // SNP_WALK_FRAMED=1 (2026-08-18, A78): clear the shadow stack whenever the
+    // game's frame counter moves, making `levels` a strictly WITHIN-FRAME depth.
+    //
+    // Why this control exists. The pop rule below drops entries whose recorded
+    // sp is at or below the current one. That is correct within a single
+    // descent, but the walker's entry sp itself falls 0x18 per frame (A72), so
+    // LAST frame's entries sit at a HIGHER sp and can never be popped. They
+    // accumulate, one per frame -- which would grow `levels` by exactly +1 per
+    // frame and make every new descent look like it revisited an ancestor,
+    // producing precisely the numbers A72/A74/A75 rest on. That is the same
+    // shape as I2, where a pop comparison manufactured phantom depth and
+    // phantom cycles in a known-healthy window.
+    //
+    // If `levels` still grows with this enabled, the recursion is genuinely
+    // deepening. If it pins at 9, the growth was an artifact of this probe and
+    // the drift is something other than depth.
+    static const bool framed = getenv("SNP_WALK_FRAMED") != nullptr;
+    if (framed) {
+        // NOT the game's frame counter in RDRAM. Reading that per call is the
+        // one ingredient I13 identified as slowing the walk path ~15x, and the
+        // first version of this control reproduced exactly that (gfx 2653 ->
+        // 420, onset never reached). g_gfx_task_count is an in-process atomic
+        // that already ticks once per frame and the probe already reads it.
+        uint32_t fr = (uint32_t)g_gfx_task_count.load();
+        if (fr != s.last_frame) {
+            s.last_frame = fr;
+            s.path.clear();
+            // A80: freeze the frame just completed so the reporter sees a whole
+            // frame rather than a partial one.
+            if (s.f_max_sp != 0) {
+                s.p_max_sp = s.f_max_sp;
+                s.p_min_sp = s.f_min_sp;
+            }
+            s.f_max_sp = 0;
+            s.f_min_sp = 0xFFFFFFFFu;
+        }
+        if (sp > s.f_max_sp) s.f_max_sp = sp;
+        if (sp < s.f_min_sp) s.f_min_sp = sp;
+    }
+    while (!s.path.empty() && s.path.back().first <= sp) {
+        s.path.pop_back();
+    }
+    // A18 (2026-08-18): DEEPER FROM A NEW ROOT, or RE-ENTERING THE SAME NODES?
+    // A72 established the mechanism (+1 recursion level per frame at 0x18 per
+    // level) but not the driver. After the pop loop above, an empty path means
+    // nothing from a previous descent is still live, so this call IS the
+    // top-level entry and `node` is the walk's root.
+    //
+    // Tracked here rather than in a toml hook for a measured reason: I13 found
+    // that ANY extra code in that hook slows the game ~15x and suppresses the
+    // bug outright (147,266 walker calls -> 1,120, levels 1345 -> 9). This
+    // costs three integer ops inside a lock we already hold.
+    if (s.path.empty()) {
+        s.roots++;
+        if (node != s.root) {
+            s.root_changes++;
+            s.root = node;
+        }
+    }
+
+    for (const auto& [frame_sp, frame_node] : s.path) {
+        if (frame_node == node) {
+            if (s.cycles++ == 0) {
+                s.cycle_node = node;
+                s.cycle_depth = (uint32_t)s.path.size();
+                // Snapshot the offending EDGE, not just the fact of a cycle.
+                // The parent is the frame we were called from; its child list
+                // is the byte array that gained an index pointing back at an
+                // ancestor. Capturing its address and contents here is what
+                // makes the next step a targeted watchpoint instead of a
+                // search -- and the list is a table of indices, so watching
+                // the node+8 POINTER would miss the write entirely.
+                s.cycle_parent = s.path.back().second;
+                s.cycle_gfx = g_gfx_task_count.load();
+                if (valid(s.cycle_parent)) {
+                    s.cycle_list = *(uint32_t*)(rdram + ((s.cycle_parent + 8) - 0x80000000u));
+                    if (valid(s.cycle_list)) {
+                        for (uint32_t i = 0; i < 8; i++) {
+                            s.cycle_list_bytes[i] =
+                                rdram[((s.cycle_list + i) ^ 3) - 0x80000000u];
+                        }
+                    }
+                }
+                for (const auto& [asp, anode] : s.path) {
+                    if (s.cycle_path.size() < 12) {
+                        s.cycle_path.push_back(anode);
+                    }
+                }
+            }
+            break;
+        }
+    }
+    s.path.push_back({ sp, node });
+    if (s.path.size() > s.max_path) {
+        s.max_path = (uint32_t)s.path.size();
+        s.deepest_node = node;
+    }
+}
+
+// Reported once a second by the heartbeat thread rather than from the probe
+// itself: the walk runs in bursts, so in-probe reporting went silent for whole
+// stretches -- including, in the first run, the seven seconds leading up to the
+// freeze, which is precisely the interval of interest.
+// --- Sort-pivot probe (SNP_SORT=1) ------------------------------------------
+//
+// DIAGNOSTIC (2026-08-18). boot_func_8003860C SIGSEGVs the instant START is
+// pressed. Its opening instructions are a median-of-three pivot selection:
+//
+//     a0 = array of pointers, a1 = i, a2 = j, mid = (i + j) >> 1
+//     f4 = *(float*)array[i]; f2 = *(float*)array[j]; f0 = *(float*)array[mid]
+//     c.lt.s f4, f2 ...
+//
+// i.e. a quicksort ordering objects by a float key. The fault is a NULL
+// dereference (measured: index register 0x80000000, which is what MEM_W
+// produces from a game pointer of 0x00000000), so one of those three slots is
+// null. This reports WHICH, plus the surrounding slots, so the bad entry can be
+// traced back to whatever failed to populate it.
+//
+// Hooked at function entry, so a0/a1/a2 are still the incoming arguments.
+extern "C" void recomp_sort_probe(uint8_t* rdram, uint32_t array, uint32_t i, uint32_t j) {
+    static const bool enabled = getenv("SNP_SORT") != nullptr;
+    if (!enabled) {
+        return;
+    }
+    auto valid = [](uint32_t a) { return a >= 0x80000000u && a < 0x80800000u; };
+    auto slot = [&](uint32_t k) -> uint32_t {
+        uint32_t at = array + k * 4;
+        if (!valid(at)) {
+            return 0xDEADDEADu;
+        }
+        return *(uint32_t*)(rdram + (at - 0x80000000u));
+    };
+
+    static std::atomic<uint64_t> calls{ 0 };
+    uint64_t n = calls.fetch_add(1) + 1;
+    uint32_t mid = (i + j) >> 1;
+
+    if (!valid(array)) {
+        fprintf(stderr, "[sort] call %llu: ARRAY ITSELF INVALID 0x%08X (i=%u j=%u)\n",
+            (unsigned long long)n, array, i, j);
+        return;
+    }
+
+    uint32_t pi = slot(i), pj = slot(j), pm = slot(mid);
+    bool bad = !valid(pi) || !valid(pj) || !valid(pm);
+
+    // First few calls unconditionally: a positive control proving the probe
+    // fires and reads sane values on the healthy path, so a later "bad" report
+    // cannot be confused with a probe that was simply never right.
+    if (n <= 3 || bad) {
