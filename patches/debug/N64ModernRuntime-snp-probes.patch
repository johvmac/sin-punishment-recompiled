+// --- VI delivery probe (SNP_VI_PROBE=1, or =<addr> for another queue) -------
+//
+// DIAGNOSTIC (2026-08-17). At the attract freeze, thread 19 (display scheduler,
+// pri 120) is blocked on 0x800A326C awaiting VI retrace, while thread 3 drains
+// external messages ~1,420 times/second. If a retrace were delivered there,
+// do_send would queue thread 19 and check_running_queue WOULD hand off (120 >
+// 10). It never does. Three explanations; these counters separate them:
+//
+//   1. VI stops enqueueing        -> vi_enq delta goes to 0
+//   2. enqueued but sent elsewhere -> vi_enq keeps rising, send_* stay 0
+//      (vi_mq shows the address it actually went to)
+//   3. delivered, nobody waiting   -> send_ok rises but woke stays 0
+//      (and send_full rising means the queue is backing up unreceived)
+//
+// Counters only; all printing is done once/second by the heartbeat thread, so
+// the timeline keeps advancing after the game goes quiet.
+std::atomic<uint64_t> g_viprobe_vi_enq{ 0 };
+std::atomic<uint32_t> g_viprobe_vi_mq{ 0 };
+std::atomic<uint64_t> g_viprobe_send_ok{ 0 };
+std::atomic<uint64_t> g_viprobe_send_full{ 0 };
+std::atomic<uint64_t> g_viprobe_send_woke{ 0 };
+std::atomic<uint64_t> g_viprobe_recv_ok{ 0 };
+std::atomic<uint64_t> g_viprobe_recv_block{ 0 };
+std::atomic<int32_t>  g_viprobe_last_blocker{ -1 };
+
+// 0 when disabled. Function-local static => thread-safe one-time init.
+uint32_t viprobe_target_mq() {
+    static const uint32_t target = []() -> uint32_t {
+        const char* e = getenv("SNP_VI_PROBE");
+        if (e == nullptr) {
+            return 0;
+        }
+        if (strcmp(e, "1") == 0) {
+            return 0x800A326Cu; // the queue thread 19 is blocked on at the freeze
+        }
+        return (uint32_t)strtoul(e, nullptr, 0);
+    }();
+    return target;
+}
