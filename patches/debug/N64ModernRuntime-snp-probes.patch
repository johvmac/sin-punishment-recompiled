+        // lists? Submission stops dead at task 1240 while everything else keeps
+        // running, so we need the caller path in order to find where the game
+        // stops entering it. Recompiled output is ordinary C with global
+        // symbols, so a native backtrace names the game functions directly.
+        // Raw addresses only -- resolve with scripts/resolve_bt.sh, since
+        // backtrace_symbols() can't see non-dynamic symbols without -rdynamic.
+        if (getenv("SNP_TASK_BT") != nullptr && (n <= 2 || n >= 1235)) {
+            char tag[64];
+            snprintf(tag, sizeof(tag), "gfx task #%llu", (unsigned long long)n);
+            probe_backtrace(tag);
+        }
