+// Companion to recomp_sort_probe: boot_func_8002AA3C sorts THREE parallel draw
+// lists out of one struct -- (ptr,count) pairs at +0xF8/+0xFC, +0x100/+0x104,
+// +0x108/+0x10C -- and the arrays are contiguous slices of a single buffer.
+// This names which bucket carries the count whose array was never filled.
+extern "C" void recomp_buckets_probe(uint8_t* rdram, uint32_t obj) {
+    static const bool enabled = getenv("SNP_SORT") != nullptr;
+    if (!enabled) {
+        return;
+    }
+    auto valid = [](uint32_t a) { return a >= 0x80000000u && a < 0x80800000u; };
+    if (!valid(obj)) {
+        return;
+    }
+    auto rd = [&](uint32_t off) {
+        return *(uint32_t*)(rdram + ((obj + off) - 0x80000000u));
+    };
+    auto first = [&](uint32_t arr) -> uint32_t {
+        if (!valid(arr)) return 0xDEADDEADu;
+        return *(uint32_t*)(rdram + (arr - 0x80000000u));
+    };
+
+    static std::atomic<uint64_t> calls{ 0 };
+    static std::atomic<uint32_t> last_sig{ 0 };
+    uint64_t n = calls.fetch_add(1) + 1;
+
+    uint32_t p0 = rd(0xF8), c0 = rd(0xFC);
+    uint32_t p1 = rd(0x100), c1 = rd(0x104);
+    uint32_t p2 = rd(0x108), c2 = rd(0x10C);
+
+    // Print the first few (positive control) and then only when the shape
+    // changes, so the transition into the bad state is visible without spam.
+    uint32_t sig = c0 ^ (c1 << 8) ^ (c2 << 16);
+    bool changed = last_sig.exchange(sig) != sig;
+    if (n <= 2 || changed) {
+        fprintf(stderr, "[buckets] call %llu obj=0x%08X | "
+                        "b0 ptr=0x%08X n=%u [0]=0x%08X | "
+                        "b1 ptr=0x%08X n=%u [0]=0x%08X | "
+                        "b2 ptr=0x%08X n=%u [0]=0x%08X\n",
+            (unsigned long long)n, obj,
+            p0, c0, first(p0), p1, c1, first(p1), p2, c2, first(p2));
+    }
+}
