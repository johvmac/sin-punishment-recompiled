+    }
+    // Per-thread totals. The global tally hid that the two threads play
+    // completely different roles -- one drives every frame, the other runs the
+    // same functions only a handful of times in a whole run.
+    for (const auto& [key, n] : phase_by_thread) {
+        fprintf(stderr, "  [%s]=%llu", key.c_str(), (unsigned long long)n);
+    }
+    fprintf(stderr, "\n[phase]   order:");
