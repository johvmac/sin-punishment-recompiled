+// --- Frame-phase probe (SNP_PHASE=1) ----------------------------------------
+//
+// DIAGNOSTIC (2026-08-18). The draw-list descriptor has two halves maintained by
+// different code: OVERLAY code populates (appends, and zeroes cursor+count at
+// frame start), RESIDENT boot code rewinds by count*4 and sorts. On the START
+// frame the resident half ran and the overlay half did not, so the rewind
+// subtracted a stale count from an unadvanced cursor.
+//
+// Two candidate shapes, needing different fixes:
+//   (a) the reset simply stops being called on the transition frame
+//   (b) it is still called, but AFTER the sort -- a phase-ordering problem
+//
+// A per-frame tally of each phase separates them. `tag` identifies the phase;
+// the counts are printed once per second by the heartbeat thread, plus the last
+// few frames' ordering so the transition frame itself is legible.
+static std::mutex phase_mutex;
+static std::map<std::string, uint64_t> phase_counts;
+static std::vector<std::string> phase_order;
+static std::map<std::string, uint64_t> phase_by_thread;
+
+extern "C" void recomp_phase_probe(uint8_t* rdram, const char* tag) {
+    static const bool enabled = getenv("SNP_PHASE") != nullptr;
+    if (!enabled) {
+        return;
+    }
+    std::lock_guard lock{ phase_mutex };
+    phase_counts[std::string(tag)]++;
+
+    // Per-frame accounting, printed AT THE REWIND rather than once a second.
+    // The crash happens inside the sort that the rewind calls, so a
+    // once-per-second report never survives to describe the fatal frame -- the
+    // t=20 line simply never printed. This fires before the fault.
+    //
+    // Also records the thread: the two halves run on DIFFERENT threads (appends
+    // on 4, rewind/sort on 3), with no synchronisation visible between them, so
+    // "did the producer run before the consumer this frame" is the question.
+    // PER THREAD. Both threads 3 and 4 run all three phases, so a single shared
+    // counter lets one thread's REWIND zero the other's tally -- which produced
+    // 169 bogus "ZERO APPENDS" reports on thread 4 in the first version, every
+    // one of them with a previous-frame history of all zeros (the tell).
+    static std::map<int32_t, uint64_t> appends_by_thread;
+    static std::map<int32_t, std::vector<uint64_t>> recent_by_thread;
+    int32_t tid = ultramodern::is_game_thread()
+        ? TO_PTR(OSThread, ultramodern::this_thread())->id
+        : -1;
+
+    phase_by_thread[std::string(tag) + ":t" + std::to_string(tid)]++;
+    // Count every phase since this thread's last REWIND, not just APPEND, so
+    // one line can say whether the populate passes ran AND whether they
+    // actually invoked any callbacks. Reported only for thread 3, which rewinds
+    // ~4 times per run -- thread 4 does it 550 times and needs no transcript.
+    static std::map<int32_t, std::map<std::string, uint64_t>> since_rewind;
+    since_rewind[tid][tag]++;
+    uint64_t& appends_this_frame = appends_by_thread[tid];
+    std::vector<uint64_t>& recent = recent_by_thread[tid];
+    if (strcmp(tag, "APPEND") == 0) {
+        appends_this_frame++;
+    }
+    else if (strcmp(tag, "REWIND") == 0) {
+        if (tid == 3) {
+            // D_80068A97 is the transition state: 0 normal, 2 just-triggered,
+            // 1 = loading, during which func_80026288 takes its NO-DRIVER
+            // branch. If the driver is running, this must not be 1 -- so its
+            // value here says whether the game's own guard was active.
+            uint32_t gate = 0xFF;
+            if (rdram != nullptr) {
+                gate = rdram[(0x80068A97u ^ 3u) - 0x80000000u];
+            }
+            fprintf(stderr, "[phase] thread3 REWIND #%llu D_80068A97=%u since last:",
+                (unsigned long long)phase_by_thread["REWIND:t3"], gate);
+            for (const auto& [k, n] : since_rewind[tid]) {
+                fprintf(stderr, " %s=%llu", k.c_str(), (unsigned long long)n);
+            }
+            fprintf(stderr, "\n");
+        }
+        since_rewind[tid].clear();
+        if (appends_this_frame == 0) {
+            fprintf(stderr, "[phase] !!! REWIND on thread %d with ZERO APPENDS this frame"
+                            " (prev frames:", tid);
+            for (uint64_t n : recent) {
+                fprintf(stderr, " %llu", (unsigned long long)n);
+            }
+            fprintf(stderr, ")\n");
+        }
+        recent.push_back(appends_this_frame);
+        if (recent.size() > 8) {
+            recent.erase(recent.begin());
+        }
+        appends_this_frame = 0;
+    }
+    static std::set<std::string> seen_tid;
+    std::string key = std::string(tag) + ":" + std::to_string(tid);
+    if (seen_tid.insert(key).second) {
+        fprintf(stderr, "[phase] %s runs on thread %d\n", tag, tid);
+    }
+    // Keep a short rolling window of the actual call ORDER. A tally alone
+    // cannot distinguish "not called" from "called too late", which is the
+    // entire question.
+    phase_order.push_back(tag);
+    if (phase_order.size() > 24) {
+        phase_order.erase(phase_order.begin());
+    }
+}
