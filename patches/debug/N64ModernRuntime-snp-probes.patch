+// --- Global message census (SNP_CENSUS=1) -----------------------------------
+//
+// DIAGNOSTIC (2026-08-17). Per-second rates for every (queue, thread, event)
+// triple, where event is S=send, R=receive, B=blocked-on-receive. Written
+// because chasing the graphics stall one queue at a time meant guessing
+// addresses out of the recompiled source, and every guess cost a run. This
+// answers "which flow stops at the freeze, and what is each thread waiting on
+// afterwards?" in ONE run with no address known in advance. Grep the output.
+//
+// KEYED ON THREAD ID, NOT A BACKTRACE, DELIBERATELY. The first version called
+// backtrace() here to name the sending game function. These paths run thousands
+// of times a second and backtrace() is slow enough that it changed the
+// cooperative scheduler's interleaving: the game died at t=8s with "No threads
+// left to run!", a failure that does not occur without the probe. A probe that
+// alters the outcome is measuring itself. Thread id is already in hand and
+// costs nothing. Once this narrows things to one queue, use the targeted
+// SNP_TASK_BT backtrace on that queue alone -- cheap, because it fires for one
+// queue only and at most once per second.
+void census_note(RDRAM_ARG PTR(OSMesgQueue) mq_, char kind) {
+    static const bool enabled = getenv("SNP_CENSUS") != nullptr;
+    if (!enabled) {
+        return;
+    }
+    int32_t thread_id = ultramodern::is_game_thread()
+        ? TO_PTR(OSThread, ultramodern::this_thread())->id
+        : -1;
+
+    using Key = std::tuple<uint32_t, int32_t, char>;
+    static std::mutex census_mutex;
+    static std::map<Key, uint64_t> totals;
+    static std::map<Key, uint64_t> prev;
+    static int64_t last_report = -1;
+    static const auto census_start = std::chrono::steady_clock::now();
+
+    std::lock_guard lock{ census_mutex };
+    totals[Key{ (uint32_t)mq_, thread_id, kind }]++;
+    int64_t secs = std::chrono::duration_cast<std::chrono::seconds>(
+        std::chrono::steady_clock::now() - census_start).count();
+    if (secs != last_report) {
+        last_report = secs;
+        for (const auto& [key, count] : totals) {
+            fprintf(stderr, "[census] t=%llds mq=0x%x thread=%d ev=%c total=%llu +%llu\n",
+                (long long)secs, std::get<0>(key), std::get<1>(key), std::get<2>(key),
